{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/wan-ti-wang/playlist.schema.json",
  "title": "Wan Ti Wang Playlist",
  "type": "object",
  "required": ["id", "name", "items"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id"],
        "properties": {
          "type": { "enum": ["question", "pack", "category", "tag"] },
          "id": { "type": "string" }
        }
      }
    }
  }
}
