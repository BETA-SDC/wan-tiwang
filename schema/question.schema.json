{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/wan-ti-wang/question.schema.json",
  "title": "Wan Ti Wang Question",
  "type": "object",
  "required": ["id", "type", "title", "prompt", "answer", "category", "status"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{6}$"
    },
    "type": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "answer": {
      "type": "array",
      "minItems": 1
    },
    "reveal": {
      "type": "string"
    },
    "fun_fact": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "mood": {
      "type": "array",
      "items": { "type": "string" }
    },
    "occasion": {
      "type": "array",
      "items": { "type": "string" }
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role"],
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    },
    "play_time_sec": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": ["draft", "review", "published", "deprecated"]
    }
  }
}
