tmp/

# Keep media metadata in Git, but keep local media files out for now.
media/images/**
media/audio/**
media/video/**
media/thumbnails/**
!media/images/.gitkeep
!media/audio/.gitkeep
!media/video/.gitkeep
!media/thumbnails/.gitkeep

