{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/wan-ti-wang/question.schema.json",
  "title": "Wan Ti Wang Question",
  "type": "object",
  "required": ["id", "type", "title", "prompt", "answer", "category", "status"],
  "additionalProperties": true,
  "$defs": {
    "localizedText": {
      "type": "object",
      "required": ["zh-CN", "en-US"],
      "additionalProperties": false,
      "properties": {
        "zh-CN": {
          "type": "string",
          "minLength": 1
        },
        "en-US": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mediaRef": {
      "type": "object",
      "required": ["id", "role"],
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string" },
        "kind": {
          "enum": ["image", "audio", "video", "thumbnail"]
        },
          "hint": { "$ref": "#/$defs/localizedText" }
      }
    },
    "answerItem": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "left": { "type": "string" },
            "right": { "type": "string" },
            "id": { "type": "string" }
          }
        }
      ]
    },
    "optionLike": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "text": { "$ref": "#/$defs/localizedText" },
        "media": {
          "type": "array",
          "items": { "$ref": "#/$defs/mediaRef" }
        }
      }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{6}$"
    },
    "type": {
      "enum": ["single_choice", "multiple_choice", "true_false", "fill_blank", "numeric", "short_answer", "ordering", "matching", "hotspot"]
    },
    "title": {
      "$ref": "#/$defs/localizedText"
    },
    "prompt": {
      "$ref": "#/$defs/localizedText"
    },
    "options": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/optionLike"
      }
    },
    "answer": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/answerItem" }
    },
    "answer_rules": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "case_sensitive": { "type": "boolean" },
        "trim": { "type": "boolean" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/localizedText" }
        },
        "numeric": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "value": { "type": "number" },
            "tolerance": { "type": "number" },
            "unit": { "type": "string" }
          }
        }
      }
    },
    "reveal": {
      "$ref": "#/$defs/localizedText"
    },
    "fun_fact": {
      "$ref": "#/$defs/localizedText"
    },
    "category": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "mood": {
      "type": "array",
      "items": { "type": "string" }
    },
    "occasion": {
      "type": "array",
      "items": { "type": "string" }
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mediaRef"
      }
    },
    "pairs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "left": {
          "type": "array",
          "items": { "$ref": "#/$defs/optionLike" }
        },
        "right": {
          "type": "array",
          "items": { "$ref": "#/$defs/optionLike" }
        }
      }
    },
    "hotspots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "shape"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "shape": { "enum": ["rect", "circle", "polygon"] },
          "label": { "$ref": "#/$defs/localizedText" },
          "x": { "type": "number", "minimum": 0, "maximum": 1 },
          "y": { "type": "number", "minimum": 0, "maximum": 1 },
          "width": { "type": "number", "minimum": 0, "maximum": 1 },
          "height": { "type": "number", "minimum": 0, "maximum": 1 },
          "radius": { "type": "number", "minimum": 0, "maximum": 1 },
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    "play_time_sec": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": ["draft", "review", "published", "deprecated"]
    }
  }
}
