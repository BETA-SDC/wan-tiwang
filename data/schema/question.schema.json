{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/wan-ti-wang/question.schema.json",
  "title": "Wan Ti Wang Question",
  "type": "object",
  "required": ["id", "type", "title", "prompt", "answer", "category", "status"],
  "additionalProperties": true,
  "$defs": {
    "localizedText": {
      "type": "object",
      "required": ["zh-CN", "en-US"],
      "additionalProperties": false,
      "properties": {
        "zh-CN": {
          "type": "string",
          "minLength": 1
        },
        "en-US": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mediaRef": {
      "type": "object",
      "required": ["id", "role"],
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string" },
        "kind": {
          "enum": ["image", "audio", "video", "thumbnail"]
        },
        "hint": { "$ref": "#/$defs/localizedText" }
      }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{6}$"
    },
    "type": {
      "enum": ["single_choice", "multiple_choice", "true_false", "fill_blank", "short_answer"]
    },
    "title": {
      "$ref": "#/$defs/localizedText"
    },
    "prompt": {
      "$ref": "#/$defs/localizedText"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "text": { "$ref": "#/$defs/localizedText" },
          "media": {
            "type": "array",
            "items": { "$ref": "#/$defs/mediaRef" }
          }
        }
      }
    },
    "answer": {
      "type": "array",
      "minItems": 1
    },
    "reveal": {
      "$ref": "#/$defs/localizedText"
    },
    "fun_fact": {
      "$ref": "#/$defs/localizedText"
    },
    "category": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "mood": {
      "type": "array",
      "items": { "type": "string" }
    },
    "occasion": {
      "type": "array",
      "items": { "type": "string" }
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mediaRef"
      }
    },
    "play_time_sec": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": ["draft", "review", "published", "deprecated"]
    }
  }
}
